{
  "name": "Stover",
  "short_name": "Stover",
  "description": "Classify crop residue, green canopy, and bare soil cover from downward-facing field images with a U-Net — right in your browser. No account, no server, no upload.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f110e",
  "theme_color": "#0f110e",
  "icons": [
